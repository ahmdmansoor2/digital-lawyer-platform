rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── UID المدير الوحيد ─────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'IlX9UsOjr3cJMH09crj2JTHhRmh1';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── اشتراكات: المستخدم ينشئ trial، المدير يفعّل/يلغي، الكل يقرأ ──
    // v2.9.10: split write into create (user can create own trial) + update/delete (admin only)
    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.status == 'trial';
      allow update, delete: if isAdmin();
    }

    // ── بيانات المستخدم: كل مستخدم يملك بياناته، المدير يقرأ الكل ─────
    // الوثيقة الرئيسية users/{userId}: المالك والمدير يقرآن ويكتبان
    // المجموعات الفرعية users/{userId}/...: المالك يقرأ ويكتب، المدير يقرأ فقط
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      match /{document=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
    }

    // ── النشرة البريدية: اشتراك عام (إنشاء فقط) بلا أي قراءة/تعديل من العملاء ──
    match /newsletter_subscribers/{subId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt', 'src'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 5
                    && request.resource.data.email.size() < 120
                    && request.resource.data.src in ['home', 'blog', 'digest'];
      allow read, update, delete: if false; // الإدارة تتم عبر Admin SDK من CI فقط
    }

    // ── توكنات إشعارات المتصفح (Push) — نفس المنطق ─────────────────────
    match /push_tokens/{tokenId} {
      allow create: if request.resource.data.keys().hasOnly(['token', 'ts', 'ua'])
                    && request.resource.data.token is string
                    && request.resource.data.token.size() > 20;
      allow read, update, delete: if false;
    }

    // ── منع أي وصول غير مُصرَّح به ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
