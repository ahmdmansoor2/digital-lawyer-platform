# مفتاح واجهة برمجة تطبيقات Gemini للذكاء الاصطناعي
GEMINI_API_KEY=

# ─── Telegram Executive Assistant Bot ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=5839970382

# ─── Facebook Page Auto-Publishing ─────────────────────────────────────────────
# معرّف صفحة فيسبوك التي تُنشر عليها المقالات
FB_PAGE_ID=
# Page Access Token دائم (لا ينتهي) — يُستخرج من توكن مستخدم طويل عبر /me/accounts
FB_PAGE_TOKEN=
# بيانات تطبيق فيسبوك — للتبديل التلقائي للتوكن عند انتهائه (كل 60 يوم)
FB_APP_ID=
FB_APP_SECRET=

# Redirect URI لـ Facebook OAuth (سجّله في Facebook App Settings → Valid OAuth Redirect URIs)
FB_REDIRECT_URI=http://localhost:8788/oauth/callback
FB_OAUTH_PORT=8788

# تفعيل توليد Reel أوتوماتيك بعد daily-publish (1 = مفعّل، 0 = متعطّل)
REELS_AUTO=0

# تفعيل توليد فيديو TikTok أوتوماتيك بعد daily-publish
TIKTOK_AUTO=0

# معرف عميل جوجل لمزامنة التقويم (Google OAuth Client ID)
VITE_GOOGLE_CLIENT_ID=

# ─── TikTok Content Posting API ──────────────────────────────────────────────
# احصل عليها من https://developers.tiktok.com/apps/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# توكنز OAuth (تُنشأ بتشغيل: node scripts/tiktok-publisher/oauth-handler.cjs login)
# تُرفع لاحقاً كـ GitHub Secrets لجدولة النشر عبر .github/workflows/daily-tiktok.yml
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_EXPIRES_IN=
TIKTOK_REFRESH_EXPIRES_IN=

# Redirect URI المسجّل في TikTok Developer Portal
# للتطوير على الجهاز: http://localhost:8787/oauth/callback
# للإنتاج: https://justice-91571.web.app/tiktok-oauth-callback.html
TIKTOK_REDIRECT_URI=http://localhost:8787/oauth/callback

# منفذ الـ local server اللي يستقبل OAuth callback
TIKTOK_OAUTH_PORT=8787

# ─── Edge TTS (Microsoft) — مجاني ────────────────────────────────────────────
# صوت عربي افتراضي — جرّب 'ar-EG-ShakirNeural' أو 'ar-SA-HamedNeural'
# قائمة الأصوات: https://learn.microsoft.com/azure/ai-services/speech-service/language-support
EDGE_TTS_VOICE=ar-EG-ShakirNeural

# ─── Pexels (صور وفيديو stock مجاني) ────────────────────────────────────────
# سجّل مجاناً في https://www.pexels.com/api/ — 200 طلب/ساعة، 20000/شهر
PEXELS_API_KEY=

# ─── موسيقى خلفية (اختياري) ─────────────────────────────────────────────────
# لو عايز موسيقى، حط مسار ملف MP3 هنا (royalty-free)
BACKGROUND_MUSIC_PATH=
