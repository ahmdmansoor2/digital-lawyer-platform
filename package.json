{
  "name": "digitallawyer-platform",
  "private": true,
  "version": "2.9.10",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "منصة إدارة مكاتب المحاماة المصرية — Electron + React 19 + TypeScript + IndexedDB",
  "author": {
    "name": "أحمد منصور",
    "email": "[email protected]"
  },
  "license": "UNLICENSED",
  "keywords": [
    "law",
    "egypt",
    "legal",
    "case-management",
    "electron",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs --banner:js=\"import { createRequire as __cR } from 'module'; const require = __cR(import.meta.url);\"",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');for(const p of ['dist','dist-desktop','server.js','server.cjs','server.mjs']){try{fs.rmSync(p,{recursive:true,force:true});}catch(e){}}\"",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:list": "playwright test --config e2e/playwright.config.ts --list",
    "test:e2e:report": "playwright show-report",
    "test:e2e:debug": "playwright test --config e2e/playwright.config.ts --debug",
    "electron:dev": "electron . --dev",
    "electron:build": "vite build && electron-builder",
    "build:desktop": "npm run electron:build && powershell -Command \"Copy-Item -LiteralPath 'dist-desktop\\منصة المحامي الرقمية 2.9.10.exe' -Destination ([Environment]::GetFolderPath('Desktop')+'\\منصة المحامي الرقمية 2.9.10.exe') -Force; Copy-Item -LiteralPath 'dist-desktop\\منصة المحامي الرقمية Setup 2.9.10.exe' -Destination ([Environment]::GetFolderPath('Desktop')+'\\منصة المحامي الرقمية Setup 2.9.10.exe') -Force\"",
    "build:license": "electron-builder --projectDir license-generator-app --config electron-builder.json && powershell -Command \"Copy-Item -LiteralPath 'license-generator-app\\dist-desktop\\مولد تراخيص المحامي الرقمية 1.0.0.exe' -Destination ([Environment]::GetFolderPath('Desktop')+'\\مولد تراخيص المحامي الرقمية 1.0.0.exe') -Force\"",
    "blog:publish": "node scripts/blog-publisher/daily-publish.cjs",
    "blog:dry-run": "node scripts/blog-publisher/daily-publish.cjs --dry-run",
    "blog:setup-task": "powershell -ExecutionPolicy Bypass -File scripts/blog-publisher/install-task.ps1"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-react": "^5.0.4",
    "dompurify": "^3.4.12",
    "dotenv": "^17.2.3",
    "edge-tts": "^1.0.1",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.16.0",
    "form-data": "^4.0.6",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "minisearch": "^7.2.0",
    "node-edge-tts": "^1.2.10",
    "pako": "^2.1.0",
    "pdfjs-dist": "^4.4.168",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "electron": "42.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase-tools": "^15.24.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.lawfirm.digitallawyer",
    "productName": "منصة المحامي الرقمية",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "منصة المحامي الرقمية"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
