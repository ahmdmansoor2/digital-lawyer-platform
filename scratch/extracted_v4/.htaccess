# ----------------------------------------------------------------------
# Mohami Digital - .htaccess Configuration for Hostinger / LiteSpeed / Apache
# Fixed & Optimized for Google Search Console Indexing, 301 Redirects & CWV
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Single-Hop 301 Redirect: HTTP to HTTPS & www to non-www (Preserving Path $1)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.mohamidigital\.online$ [NC]
  RewriteRule ^(.*)$ https://mohamidigital.online/$1 [L,R=301]

  # 2. Redirect explicit /index.html (root and subdirectories) to clean trailing-slash URL
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ https://mohamidigital.online/$1 [L,R=301]

  # 3. 301 Redirects for Near-Duplicate Blog Articles (Prevent Keyword Cannibalization)
  RewriteRule ^blog/bounced-checks-laws-egypt\.html$ https://mohamidigital.online/blog/bounced-check-laws-egypt.html [L,R=301]
  RewriteRule ^blog/bounced-cheque-laws-egypt\.html$ https://mohamidigital.online/blog/bounced-check-laws-egypt.html [L,R=301]
  RewriteRule ^blog/bounced-checks-provisions-egypt\.html$ https://mohamidigital.online/blog/bounced-check-laws-egypt.html [L,R=301]
  RewriteRule ^blog/bounced-cheque-penalties-egypt\.html$ https://mohamidigital.online/blog/bounced-check-penalties-egypt.html [L,R=301]
  RewriteRule ^blog/cybercrime-law-defamation-egypt\.html$ https://mohamidigital.online/blog/cybercrime-defamation-laws-egypt.html [L,R=301]
  RewriteRule ^blog/cyber-defamation-slander-laws-egypt\.html$ https://mohamidigital.online/blog/cybercrime-defamation-laws-egypt.html [L,R=301]
  RewriteRule ^blog/cybercrime-law-extortion-egypt\.html$ https://mohamidigital.online/blog/cybercrime-extortion-laws-egypt.html [L,R=301]
  RewriteRule ^blog/cybercrime-blackmail-laws-egypt\.html$ https://mohamidigital.online/blog/cybercrime-extortion-laws-egypt.html [L,R=301]
  RewriteRule ^blog/cybercrime-law-data-leaks-egypt\.html$ https://mohamidigital.online/blog/cybercrime-data-leaks-laws-egypt.html [L,R=301]
  RewriteRule ^blog/foreign-currency-trading-laws-egypt\.html$ https://mohamidigital.online/blog/foreign-currency-laws-egypt.html [L,R=301]
  RewriteRule ^blog/foreign-currency-illegal-trading-egypt\.html$ https://mohamidigital.online/blog/foreign-currency-laws-egypt.html [L,R=301]
  RewriteRule ^blog/illegal-currency-trading-penalties-egypt\.html$ https://mohamidigital.online/blog/foreign-currency-trading-penalties-egypt.html [L,R=301]
  RewriteRule ^blog/sports-contracts-egyptian-law\.html$ https://mohamidigital.online/blog/egyptian-sports-law-player-contracts.html [L,R=301]
  RewriteRule ^blog/sports-contracts-law-egypt\.html$ https://mohamidigital.online/blog/egyptian-sports-law-player-contracts.html [L,R=301]
  RewriteRule ^blog/sports-player-contracts-law-egypt\.html$ https://mohamidigital.online/blog/egyptian-sports-law-player-contracts.html [L,R=301]
  RewriteRule ^blog/sports-player-contracts-arbitration-egypt\.html$ https://mohamidigital.online/blog/sports-contracts-arbitration-egypt.html [L,R=301]
  RewriteRule ^blog/khul-divorce-procedure\.html$ https://mohamidigital.online/blog/khula-laws-personal-status-egypt.html [L,R=301]
  RewriteRule ^blog/khul-divorce-procedures-egypt\.html$ https://mohamidigital.online/blog/khula-laws-personal-status-egypt.html [L,R=301]
  RewriteRule ^blog/educational-guardianship-divorced-mother-egypt\.html$ https://mohamidigital.online/blog/educational-guardianship-divorce-egypt.html [L,R=301]
  RewriteRule ^blog/force-majeure-contract-law-egypt\.html$ https://mohamidigital.online/blog/force-majeure-clause-egyptian-law.html [L,R=301]
  RewriteRule ^blog/judicial-recess-deadlines-egypt\.html$ https://mohamidigital.online/blog/judicial-recess-court-deadlines-egypt.html [L,R=301]
  RewriteRule ^blog/official-holidays-labor-rights-egypt\.html$ https://mohamidigital.online/blog/official-holidays-labor-law-egypt.html [L,R=301]
  RewriteRule ^blog/official-holidays-overtime-labor-law-egypt\.html$ https://mohamidigital.online/blog/official-holidays-labor-law-egypt.html [L,R=301]
  RewriteRule ^blog/university-tanseeq-appeals-egypt\.html$ https://mohamidigital.online/blog/university-admission-coordination-appeals-egypt.html [L,R=301]
  RewriteRule ^blog/takaful-karama-social-pension-conditions\.html$ https://mohamidigital.online/blog/takaful-karama-pension-legal-eligibility.html [L,R=301]
  RewriteRule ^blog/company-incorporation-egypt\.html$ https://mohamidigital.online/blog/company-formation-egypt.html [L,R=301]
  RewriteRule ^blog/consumer-rights-egypt\.html$ https://mohamidigital.online/blog/consumer-protection-egypt.html [L,R=301]
  RewriteRule ^blog/currency-fluctuation-impact-contracts-egypt\.html$ https://mohamidigital.online/blog/currency-devaluation-contract-effects.html [L,R=301]
  RewriteRule ^blog/pretrial-detention-law-egypt\.html$ https://mohamidigital.online/blog/remand-in-custody-egyptian-law.html [L,R=301]
  RewriteRule ^blog/salary-delay-penalties-egypt-labor-law\.html$ https://mohamidigital.online/blog/salary-deductions-delay-labor-law.html [L,R=301]
</IfModule>

# 4. Authentic 404 Error Handling (Prevents Soft 404 & Canonical Mismatch)
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# Browser Caching & Core Web Vitals Optimization
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Media
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # CSS & JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # HTML & XML
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# Gzip / Deflate Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# SEO & Security Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Prevent XML sitemaps, webmanifest, internal search, and 404 page from being indexed as web results
  <FilesMatch "\.(xml|webmanifest)$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
  <FilesMatch "^(404|search)\.html$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
</IfModule>

# Block hidden files (.git, .env) while keeping .htaccess readable by server
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
