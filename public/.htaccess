# ----------------------------------------------------------------------
# Mohami Digital - Corrected .htaccess for Hostinger / LiteSpeed / Apache
# Auto-generated by fix_mohami_seo.py
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Single 301 Redirect: HTTP to HTTPS & www to non-www (Preserving $1 path!)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.mohamidigital\.online$ [NC]
  RewriteRule ^(.*)$ https://mohamidigital.online/$1 [L,R=301]

  # 2. Redirect /index.html to / (Prevent Duplicate Content)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ https://mohamidigital.online/ [R=301,L]

  # 3. 301 Redirects for Consolidated Duplicate Blog Articles (Keyword Cannibalization Fix)
  Redirect 301 /blog/bounced-check-penalties-egypt.html https://mohamidigital.online/blog/bounced-check-laws-egypt.html
  Redirect 301 /blog/bounced-checks-laws-egypt.html https://mohamidigital.online/blog/bounced-check-laws-egypt.html
  Redirect 301 /blog/bounced-checks-provisions-egypt.html https://mohamidigital.online/blog/bounced-check-laws-egypt.html
  Redirect 301 /blog/bounced-cheque-laws-egypt.html https://mohamidigital.online/blog/bounced-check-laws-egypt.html
  Redirect 301 /blog/bounced-cheque-penalties-egypt.html https://mohamidigital.online/blog/bounced-check-laws-egypt.html
  Redirect 301 /blog/cheque-return-egypt.html https://mohamidigital.online/blog/bounced-check-laws-egypt.html
  Redirect 301 /blog/company-formation-egypt.html https://mohamidigital.online/blog/company-incorporation-egypt.html
  Redirect 301 /blog/currency-fluctuation-impact-contracts-egypt.html https://mohamidigital.online/blog/currency-devaluation-contract-effects.html
  Redirect 301 /blog/cyber-defamation-slander-laws-egypt.html https://mohamidigital.online/blog/cybercrime-defamation-laws-egypt.html
  Redirect 301 /blog/cyberbullying-defamation-law-egypt.html https://mohamidigital.online/blog/cybercrime-defamation-laws-egypt.html
  Redirect 301 /blog/cybercrime-blackmail-laws-egypt.html https://mohamidigital.online/blog/cybercrime-extortion-laws-egypt.html
  Redirect 301 /blog/cybercrime-law-data-leaks-egypt.html https://mohamidigital.online/blog/cybercrime-data-leaks-laws-egypt.html
  Redirect 301 /blog/cybercrime-law-defamation-egypt.html https://mohamidigital.online/blog/cybercrime-defamation-laws-egypt.html
  Redirect 301 /blog/cybercrime-law-extortion-egypt.html https://mohamidigital.online/blog/cybercrime-extortion-laws-egypt.html
  Redirect 301 /blog/cybercrime-phone-extortion-egypt.html https://mohamidigital.online/blog/cybercrime-extortion-laws-egypt.html
  Redirect 301 /blog/educational-guardianship-divorced-mother-egypt.html https://mohamidigital.online/blog/educational-guardianship-divorce-egypt.html
  Redirect 301 /blog/egyptian-sports-law-player-contracts.html https://mohamidigital.online/blog/sports-contracts-law-egypt.html
  Redirect 301 /blog/force-majeure-clause-egyptian-law.html https://mohamidigital.online/blog/force-majeure-contract-law-egypt.html
  Redirect 301 /blog/foreign-currency-illegal-trading-egypt.html https://mohamidigital.online/blog/foreign-currency-laws-egypt.html
  Redirect 301 /blog/foreign-currency-trading-laws-egypt.html https://mohamidigital.online/blog/foreign-currency-laws-egypt.html
  Redirect 301 /blog/foreign-currency-trading-penalties-egypt.html https://mohamidigital.online/blog/foreign-currency-laws-egypt.html
  Redirect 301 /blog/illegal-currency-trading-penalties-egypt.html https://mohamidigital.online/blog/foreign-currency-laws-egypt.html
  Redirect 301 /blog/judicial-recess-deadlines-egypt.html https://mohamidigital.online/blog/judicial-recess-court-deadlines-egypt.html
  Redirect 301 /blog/khul-divorce-procedure.html https://mohamidigital.online/blog/khul-divorce-procedures-egypt.html
  Redirect 301 /blog/khula-laws-personal-status-egypt.html https://mohamidigital.online/blog/khul-divorce-procedures-egypt.html
  Redirect 301 /blog/official-holidays-labor-rights-egypt.html https://mohamidigital.online/blog/official-holidays-labor-law-egypt.html
  Redirect 301 /blog/official-holidays-overtime-labor-law-egypt.html https://mohamidigital.online/blog/official-holidays-labor-law-egypt.html
  Redirect 301 /blog/sports-contracts-egyptian-law.html https://mohamidigital.online/blog/sports-contracts-law-egypt.html
  Redirect 301 /blog/sports-player-contracts-arbitration-egypt.html https://mohamidigital.online/blog/sports-contracts-arbitration-egypt.html
  Redirect 301 /blog/sports-player-contracts-law-egypt.html https://mohamidigital.online/blog/sports-contracts-law-egypt.html
  Redirect 301 /blog/takaful-karama-social-pension-conditions.html https://mohamidigital.online/blog/takaful-karama-pension-legal-eligibility.html
  Redirect 301 /blog/university-tanseeq-appeals-egypt.html https://mohamidigital.online/blog/university-admission-coordination-appeals-egypt.html

  # 4. Return true HTTP 404 for missing static files (.html, .xml, .json, .txt) to prevent Soft 404
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule \.(html|xml|json|txt)$ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# Browser Caching & Core Web Vitals Optimization
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------------------
# Gzip / Brotli Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Security Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "^\.(?!well-known)">
  Order allow,deny
  Deny from all
</FilesMatch>
