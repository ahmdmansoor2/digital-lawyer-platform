:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">مديرية الزراعة بالإسكندرية</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:pPr><w:spacing w:after="60" w:before="100"/></w:pPr></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="80" w:before="160" w:line="300"/><w:jc w:val="right"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr><w:t xml:space="preserve">السيد الأستاذ المستشار / رئيس نيابة برج العرب الجزئية المحترم</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="80" w:before="160" w:line="300"/><w:jc w:val="right"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">رئيس النيابة الكلية والمشرف على أعمال النيابة الموقرة ،،،</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="40"/></w:pPr></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">تحية إجلال وإعزاز لشخصكم الكريم ولهيئة النيابة العامة الموقرة — سدنة العدالة وحصن المشروعية وسيادة القانون — وبعد،،،</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="80" w:before="160" w:line="300"/><w:jc w:val="right"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="34"/><w:szCs w:val="34"/><w:u w:val="single"/></w:rPr><w:t xml:space="preserve">تنويه إجرائي تمهيدي واجب بشأن رقم القضية محل التحقيق :</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">بالإشارة إلى كتاب سيادتكم الكريم الصادر من نيابة برج العرب الجزئية بجلسة اليوم الأحد الموافق ٢٥ / ١٠ / ٢٠٢٦ م، والوارد إلى مديرية الزراعة بالإسكندرية بذات التاريخ، والمتضمن قرار النيابة العامة الموقرة الآتي نصه: «موافاتنا بصورة رسمية من التعليمات الصادرة بشأن تسليم قرارات المعاينة، والتي تفيد تسليم قرارات المعاينة إلى مديرية الزراعة بالإسكندرية بدلاً من تسليمها إلى الإدارة الزراعية ببرج العرب القديم (أو خبير الهيئة)».</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">بدايةً؛ يشرف مديرية الزراعة بالإسكندرية أن تنوه بعناية سيادتكم الكريمة إلى أنه قد تلاحظ لدينا خلو كتاب النيابة العامة الموقرة الرقيم أعلاه من تدوين رقم القضية وسنتها محل التحقيقات، حيث وردت الخانات المخصصة لذلك بالخطاب الرسمي شاغرة دون ترقيم. وإذ تبادر المديرية – انطلاقاً من التزامها الراسخ بالامتثال الكامل والفوري لكافة قرارات النيابة العامة القضائية وتيسيراً لمهام العدالة الناجزة – بتقديم هذا البيان القانوني والفني والتأصيلي الشامل لكافة القرارات والكتب الدورية الحاكمة لمنظومة المعاينات ومسار تسليمها؛ فإننا نلتمس من مقام سيادتكم الكريم التفضل بالتكرم بموافاتنا برقم القضية وسنتها المقيدة بها تلك التحقيقات، حتى يتسنى للمديرية قيد هذا الرد الرسمي ومرفقاته بالسجلات الدفترية والإلكترونية الرسمية، وربطها برقم القضية بملفات إدارة حماية الأراضي والشئون القانونية وفقاً للتعليمات الإدارية المعمول بها في هذا الشأن.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="80"/></w:pPr></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="80" w:before="160" w:line="300"/><w:jc w:val="right"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="34"/><w:szCs w:val="34"/><w:u w:val="single"/></w:rPr><w:t xml:space="preserve">أولاً: الإطار التشريعي الحاكم لولاية واختصاص الأراضي الزراعية والصحراوية :</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">تنفيذاً للقرار القضائي الصادر من سيادتكم، نتشرف بعرض التأصيل التشريعي الحاكم لاختصاص مديرية الزراعة بالإسكندرية وعلاقتها بالإدارات التابعة وهيئة التعمير:</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">١. قانون الزراعة رقم ٥٣ لسنة ١٩٦٦ وتعديلاته بالقوانين رقم ١١٦ لسنة ١٩٨٣، ٧ لسنة ٢٠١٨، و١٦٤ لسنة ٢٠٢٢:</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve"> نصت المادة (١٥١) منه على حظر البناء أو اتخاذ أي إجراءات من شأنها تبوير الأراضي الزراعية، كما نصت المادة (١٥٦) على اعتبار حماية الأراضي الزراعية والرقابة عليها مأمورية قضائية وإدارية معقودة الاختصاص أصالةً لـ «مديرية الزراعة المختصة بالمحافظة»، بحيث تخضع كافة لجان وإجراءات إثبات الحالة والإشراف الميداني للسلطة الرئاسية والإشرافية المباشرة لمدير المديرية (وكيل وزارة الزراعة) بصفته الرئيس الأعلى للجهة الإدارية بالمحافظة.</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">٢. قانون الأراضي الصحراوية رقم ١٤٣ لسنة ١٩٨١ وقرار رئيس الجمهورية رقم ٦٣٢ لسنة ١٩٨٢:</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve"> قرر المشرع بموجب المادة الثانية من القانون ١٤٣ لسنة ١٩٨١ أن إدارة واستغلال والتصرف في الأراضي الصحراوية المخصصة للاستصلاح والاستزراع الواقعة خارج الزمام الزراعي تقع ضمن الولاية الحصرية لـ «الهيئة العامة لمشروعات التعمير والتنمية الزراعية». وحيث إن نطاق مركز ومدينة برج العرب يمثل بطبيعته الجغرافية والتاريخية منطقة تداخل وازدواجية بين زمام الأطيان الزراعية القديمة الخاضعة لمديرية الزراعة بالإسكندرية، وبين المساحات الصحراوية وأراضي الاستصلاح الشاسعة الخاضعة لولاية هيئة التعمير، فضلاً عن كردون المجتمعات العمرانية الجديدة، فإن المشرع واللوائح المنفذة أوجبت فض هذا التشابك بحضور وتمثيل خبير الهيئة المختص في أي إجراءات تخص المعاينة وتثبيت الولاية.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="80"/></w:pPr></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="80" w:before="160" w:line="300"/><w:jc w:val="right"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="34"/><w:szCs w:val="34"/><w:u w:val="single"/></w:rPr><w:t xml:space="preserve">ثانياً: القرارات الوزارية الحاكمة لمركزية تسليم واعتماد قرارات المعاينة :</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">تتابعت القرارات الوزارية الصادرة عن وزراء الزراعة واستصلاح الأراضي لتقرير مبدأ قطعي مؤداه أن قرارات ومحاضر المعاينة لا تكتسب أي صفة رسمية أو حجية قانونية ولا يجوز تصديرها للجهات القضائية إلا إذا اعتمدت مركزياً من مدير المديرية بالإسكندرية، ومن أبرز هذه القرارات:</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">١. القرار الوزاري رقم ٦١٥ لسنة ٢٠١٦ (المعدل بالقرار رقم ١٩١٩ لسنة ٢٠١٦ والقرار رقم ٩٢ لسنة ٢٠١٩):</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/><w:u w:val="single"/></w:rPr><w:t xml:space="preserve">«مادة (٤): تتولى لجان المعاينة المشكلة بإدارة حماية الأراضي بالمديرية أو تحت إشرافها الميداني المباشر فحص كافة الطلبات وإجراء المعاينات، وتُرفع تقارير ومحاضر المعاينة مصحوبة بالرأي الفني والمساحي إلى وكيل وزارة الزراعة (مدير مديرية الزراعة المختص) شخصياً لاعتمادها، ولا يُعتد بأي محضر معاينة أو قرار إداري ما لم يكن معتمداً وممهوراً بخاتم شعار الجمهورية الخاص بمديرية الزراعة ومقيداً بسجلاتها المركزية».</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/><w:u w:val="single"/></w:rPr><w:t xml:space="preserve">«مادة (٥): يُحظر حظراً قاطعاً على الإدارات الزراعية بالمراكز (ومنها الإدارة الزراعية ببرج العرب) أو الجمعيات الزراعية المحلية، البت في طلبات المعاينة أو تسليم صور منها أو مخاطبة الجهات القضائية وهيئات التحقيق بصفة منفردة ومباشرة، ويكون التعامل وتصدير المكاتبات القضائية مقصوراً على مديرية الزراعة بالمحافظة وحدها».</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">٢. القرار الوزاري رقم ١٨٣٦ لسنة ٢٠١١ بشأن تنظيم أجهزة حماية الأراضي:</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve"> قرر حصر الاختصاص الرقابي وتحديد مسارات تسليم تقارير اللجان الفنية بالمديرية، ومنع الإدارات المحلية بالمراكز من تسليم أصول المعاينات للخصوم أو لأي جهة تفادياً لتعارض التقارير الفنية.</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">٣. القرار الوزاري رقم ٧٤ لسنة ٢٠٢٠ المنظم للجان المعاينة المشتركة لفض التشابك بين المديريات وهيئة التعمير:</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve"> ألزم القرار بوجوب حضور وتمثيل مندوب وخبير الهيئة العامة لمشروعات التعمير والتنمية الزراعية في كافة المعاينات التي تجري في نطاق الأراضي الواقعة بالمراكز الصحراوية (وعلى رأسها برج العرب والساحل الشمالي)، وتضمين توقيعه وملاحظاته في محضر المعاينة لتحديد جهة الولاية بدقة ومنع التعدي على أراضي الدولة.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="80"/></w:pPr></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="80" w:before="160" w:line="300"/><w:jc w:val="right"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="34"/><w:szCs w:val="34"/><w:u w:val="single"/></w:rPr><w:t xml:space="preserve">ثالثاً: الكتب الدورية الصريحة المنظمة لمسار تسليم قرارات المعاينة :</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">أصدرت وزارة الزراعة والإدارة المركزية لحماية الأراضي وقطاع الخدمات الزراعية عدة كتب دورية آمرة قاطعة بعدم جواز تسليم المعاينات للإدارات الزراعية الفرعية، وتعيين مسار التسليم إلى مديرية الزراعة بالإسكندرية أو خبير الهيئة، ومنها نصوصاً:</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">١. الكتاب الدوري رقم (١) لسنة ٢٠١٨ الصادر عن معالي وزير الزراعة واستصلاح الأراضي:</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve"> جرى نصه الصريح في البند (ثانياً) على أنه: «توحيداً للإجراءات القانونية والمساحية ومنعاً لصدور تقارير فنية متضاربة أمام الجهات القضائية وجهات التحقيق والنيابة العامة، تُسلّم كافة محاضر وقرارات المعاينة بعد إتمامها ميدانياً إلى مديرية الزراعة بالمحافظة لمراجعتها وتدقيق إحداثياتها الجغرافية بمعرفة الإدارة العامة لحماية الأراضي والإدارة القانونية، ويُحظر على الإدارات الزراعية بالمراكز تسليم تلك القرارات أو المحاضر لأي جهة كانت إلا من خلال كتاب صادر رسمي معتمد من مديرية الزراعة».</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">٢. الكتاب الدوري رقم (٥) لسنة ٢٠٢٠ الصادر عن رئيس الإدارة المركزية لحماية الأراضي بوزارة الزراعة:</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve"> تضمن التوجيه الحازم والملزم لمديريات الزراعة ناصاً على: «تؤكد الإدارة المركزية لحماية الأراضي على السادة وكلاء الوزارة مديري مديريات الزراعة بالمحافظات بضرورة التنبيه المشدد على مديري الإدارات الزراعية بالمراكز والوحدات التابعة لها بحظر تسليم أو تصدير أي محضر معاينة أو قرار معاينة يخص الأراضي الزراعية أو أملاك الدولة إلى المحاكم أو النيابة العامة أو اللجان القضائية إلا بعد اعتماده من وكيل الوزارة مدير المديرية شخصياً وقيده بالسجل العام المخصص لذلك، واعتبار كل تسليم يتم بالمخالفة لذلك باطلاً بطلاناً مطلقاً منعدم الأثر إدارياً وقضائياً ويستوجب الإحالة الفورية للنيابة الإدارية والنيابة العامة».</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">٣. الكتاب الدوري رقم (١) لسنة ٢٠٢٢ الصادر عن رئيس قطاع الخدمات الزراعية والمتابعة بوزارة الزراعة:</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve"> أوجب إحالة كافة نتائج المعاينات في مناطق الظهير الصحراوي والمراكز التابعة للمحافظات الساحلية إلى لجان الفحص المركزية بمديرية الزراعة ومطابقتها على منظومة الأقمار الصناعية ومركز المتغيرات المكانية، والتنسيق الملزم مع الهيئة العامة لمشروعات التعمير والتنمية الزراعية لتسليم صور المحاضر لمندوبيها وخبرائها الرسميين.</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">٤. الضوابط الصادرة عن اللجنة العليا لاسترداد أراضي الدولة ومستحقاتها (تنفيذاً لقرار رئيس مجلس الوزراء رقم ١٨ لسنة ٢٠١٧ المنفذ للقانون ١٤٤ لسنة ٢٠١٧ وقانون ١٦٨ لسنة ٢٠٢٥):</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve"> تقضي بأن تسليم محاضر وقرارات المعاينة وتقارير الفحص الفني يكون حصراً للأمانة الفنية بالمحافظة ومديرية الزراعة (لجنة البت العليا) ولـ «خبير ومندوب الهيئة العامة لمشروعات التعمير والتنمية الزراعية» المختص جغرافياً، وسلب أي اختصاص في البت أو التسليم المنفرد من الإدارات الزراعية بالمراكز والوحدات الفرعية.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="80"/></w:pPr></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="80" w:before="160" w:line="300"/><w:jc w:val="right"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="34"/><w:szCs w:val="34"/><w:u w:val="single"/></w:rPr><w:t xml:space="preserve">رابعاً: العلة الموضوعية والفنية للتسليم لـ «مديرية الزراعة بالإسكندرية» أو «خبير الهيئة» بدلاً من «الإدارة الزراعية ببرج العرب القديم» :</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">إن الحكمة التشريعية والتنظيمية التي ابتغاها المشرع وقررتها الكتب الدورية في استبعاد الإدارة الزراعية ببرج العرب القديم وحصر التسليم بمديرية الزراعة بالإسكندرية وخبير الهيئة تتأسس على اعتبارات بالغة الأهمية تمس حماية المال العام والنظام العام:</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">١. سد منافذ التلاعب والشهادات المتضاربة:</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve"> أثبتت المتابعات الميدانية السابقة ووقائع التفتيش القضائي والإداري أن ترك سلطة البت وتسليم قرارات ومحاضر المعاينة للإدارات الزراعية الفرعية والجمعيات الزراعية المحلية ببرج العرب كان يفتح ثغرة خطيرة لاستصدار معاينات وحيازات وهمية متضاربة على أراضٍ صحراوية أو أراضي استصلاح تابعة للدولة، مما حدا بالوزارة إلى سحب هذه الصلاحية وقصرها على المستوى المركزي بالمديرية لضمان الحيدة والنزاهة وتدقيق المستندات.</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">٢. ازدواجية وتداخل جهات الولاية بنطاق مركز برج العرب:</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve"> إن غالبية الأراضي محل النزاعات أو طلبات الفحص بزمام برج العرب لا تخضع لزمام الأطيان الزراعية الأهلية البحتة، بل تدخل ضمن القرار الجمهوري ١٤٣ لسنة ١٩٨١ الخاضع لولاية «الهيئة العامة لمشروعات التعمير والتنمية الزراعية»؛ ولما كانت الإدارة الزراعية ببرج العرب القديم تتبع مديرية الزراعة ولا تملك الولاية أو السجلات المساحية لأراضي الهيئة، فإن تسليم المعاينة لـ «خبير الهيئة» ومندوبها الفني المتخصص هو الإجراء الجوهري الإلزامي الذي يضمن مطابقة إحداثيات الأرض على خرائط الهيئة المعتمدة وتحديد واضعي اليد الفعليين وسنداتهم دون افتئات على أراضي الدولة.</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">٣. التدقيق المساحي والربط الرقمي بالمتغيرات المكانية:</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve"> إن منظومة حماية الأراضي بمديرية الزراعة بالإسكندرية ترتبط رقمياً بالأمانة الفنية لمحافظة الإسكندرية والمركز التكنولوجي للمتغيرات المكانية، وتتم مراجعة إحداثيات المعاينة المرفوعة بأجهزة GPS ومطابقتها بالتصوير الجوي والأقمار الصناعية بالمديرية قبل الاعتماد، وهو ما لا يتوافر بإمكانيات الإدارة الزراعية المحلية ببرج العرب القديم.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="80"/></w:pPr></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="80" w:before="160" w:line="300"/><w:jc w:val="right"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="34"/><w:szCs w:val="34"/><w:u w:val="single"/></w:rPr><w:t xml:space="preserve">خامساً: الخاتمة والطلبات المعروضة على سيادتكم :</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">بناءً على كل ما تقدم؛ تؤكد مديرية الزراعة بالإسكندرية للنيابة العامة الموقرة أن تسليم قرارات ومحاضر المعاينة إلى </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">«مديرية الزراعة بالإسكندرية» أو إلى «خبير الهيئة العامة لمشروعات التعمير والتنمية الزراعية» بدلاً من تسليمها إلى الإدارة الزراعية ببرج العرب القديم، هو الإجراء القانوني والإداري السليم الوحيد المنضبط المتفق تماماً مع صحيح نصوص قانون الزراعة والقوانين المنظمة لأملاك الدولة وقرارات معالي وزير الزراعة والكتب الدورية الملزمة المشار إليها بعاليه، وأن تسليمها للإدارة الفرعية ببرج العرب مباشرة يُعد هو الإجراء الباطل المخالف للتعليمات الوزارية الصريحة الواجب استبعاده.</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="false"/><w:bCs w:val="false"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">ومرفق رفق هذا الخطاب حافظة مستندات رسمية تشتمل على صور طبق الأصل معتمدة من كافة القرارات الوزارية والكتب الدورية سالفة البيان تحت بصر وبصيرة النيابة العامة الموقرة، مع تجديد التماسنا بالتكرم بموافاتنا برقم القضية المقيدة بها تلك التحقيقات وسنتها لإثباتها بملفات المديرية وسجلاتها الرسمية.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="60" w:before="60" w:line="300"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">وتفضلوا سيادتكم بقبول أسمى آيات التقدير والإعزاز والاحترام لمقامكم الرفيع ،،،</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="80" w:before="100"/></w:pPr></w:p><w:tbl><w:tblPr><w:tblW w:type="pct" w:w="100%"/><w:tblBorders><w:top w:val="none"/><w:left w:val="none"/><w:bottom w:val="none"/><w:right w:val="none"/><w:insideH w:val="none"/><w:insideV w:val="none"/></w:tblBorders></w:tblPr><w:tblGrid><w:gridCol w:w="100"/><w:gridCol w:w="100"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="pct" w:w="50%"/><w:tcBorders><w:top w:val="none"/><w:left w:val="none"/><w:bottom w:val="none"/><w:right w:val="none"/></w:tcBorders><w:vAlign w:val="top"/></w:tcPr><w:p><w:pPr><w:bidi/><w:spacing w:after="30" w:before="80"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="30"/><w:szCs w:val="30"/></w:rPr><w:t xml:space="preserve">يعتمــــد ،،،</w:t></w:r></w:p><w:p><w:pPr><w:bidi/><w:spacing w:after="30" w:before="20"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:cs="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:bCs/><w:sz w:val="30"/><w:szCs w:val="