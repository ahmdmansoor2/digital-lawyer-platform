  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  .logo-box {
    display: flex;
    flex-direction: column;
  }
  .brand-title {
    font-family: var(--font-family);
    font-size: 36px;
    font-weight: 900;
    color: var(--primary);
    line-height: 1.1;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .brand-title span.sawt { color: var(--primary); }
  .brand-title span.misr { color: var(--accent-red); }
  .brand-title span.badge24 {
    background: linear-gradient(135deg, var(--accent-red), #b91c1c);
    color: #ffffff;
    font-size: 20px;
    font-weight: 900;
    padding: 2px 10px;
    border-radius: 6px;
    margin-right: 4px;
    box-shadow: var(--shadow-sm);
  }
  .brand-tagline {
    font-size: 12.5px;
    color: var(--text-muted);
    margin-top: 6px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .brand-tagline::before {
    content: '';
    width: 7px;
    height: 7px;
    background-color: var(--accent-gold);
    border-radius: 50%;
    display: inline-block;
  }
  .header-ad-banner {
    width: 728px;
    height: 90px;
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    font-size: 12px;
    border-radius: var(--radius);
    overflow: hidden;
  }

  /* --- Navigation Bar --- */
  .main-nav {
    background-color: var(--primary);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: var(--shadow-md);
  }
  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nav-menu {
    display: flex;
    list-style: none;
    align-items: center;
    flex-wrap: wrap;
    padding: 0;
    margin: 0;
