  <script type='text/javascript'>
  //<![CDATA[
    try {
      const now = new Date();
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      const el = document.getElementById('live-date');
      if (el) el.innerText = now.toLocaleDateString('ar-EG', options);
      const yr = document.getElementById('current-year');
      if (yr) yr.innerText = now.getFullYear();

      // 1. استخراج وتلوين شارات الأقسام تلقائياً على بطاقات الأخبار بالرئيسية
      document.querySelectorAll('.post-card').forEach(function(card) {
        var metaCat = card.querySelector('.post-cat');
        var snippet = card.querySelector('.post-snippet');
        if (!metaCat && snippet) {
          var text = snippet.textContent || '';
          var match = text.match(/قسم:\s*([^\s<]+(?:\s+[^\s<]+)?)/);
          if (match) {
            var catName = match[1].trim();
            var postMeta = card.querySelector('.post-meta');
            if (postMeta) {
              var span = document.createElement('span');
              span.className = 'post-cat';
              span.textContent = catName;
              postMeta.insertBefore(span, postMeta.firstChild);
            }
            snippet.textContent = text.replace(/قسم:\s*[^\s<]+(?:\s+[^\s<]+)?\s*/, '').trim();
          }
        }
      });

      // 2. تفعيل شارة القسم في صفحة قراءة المقال
      var singleMeta = document.querySelector('.single-meta');
      var singleContent = document.querySelector('.post-content');
      if (singleMeta && singleContent) {
        var catPill = singleContent.querySelector('.sawt-cat-pill span');
        if (catPill) {
          var catName = catPill.textContent.replace('قسم:', '').trim();
          var hasLabel = singleMeta.querySelector('.fa-folder-open');
          if (!hasLabel) {
            var span = document.createElement('span');
            span.innerHTML = '<i class="fa-solid fa-folder-open"></i> ' + catName;
            singleMeta.appendChild(span);
          }
        }
      }

      // 3. موجه الأقسام الذكي (Category Router) لصفحات الأقسام /search/label/...
      var path = decodeURIComponent(window.location.pathname);
      if (path.indexOf('/search/label/') !== -1) {
        var targetCat = path.split('/search/label/')[1].replace(/[/?#].*$/, '').trim();
        var sectionTitle = document.querySelector('.section-title');
        if (sectionTitle) sectionTitle.textContent = 'قسم: ' + targetCat;
        
        var postsList = document.querySelector('.posts-list');
        var existingPosts = postsList ? postsList.querySelectorAll('.post-card') : [];
        
        if (existingPosts.length === 0 && postsList) {
          postsList.innerHTML = '<div style="text-align:center; padding:40px; color:#64748b;"><i class="fa-solid fa-spinner fa-spin fa-2x"></i><p style="margin-top:12px; font-weight:700;">جاري تحميل أحدث تغطيات ' + targetCat + '...</p></div>';
          fetch('/feeds/posts/default?alt=json&max-results=50')
            .then(function(r) { return r.json(); })
            .then(function(data) {
              var entries = (data.feed && data.feed.entry) || [];
              var matched = entries.filter(function(entry) {
                var content = (entry.content && entry.content.$t) || '';
                var title = (entry.title && entry.title.$t) || '';
                var categoryTags = (entry.category || []).map(function(c) { return c.term; }).join(' ');
                return content.indexOf(targetCat) !== -1 || categoryTags.indexOf(targetCat) !== -1;
              });
              
              if (matched.length === 0) {
                postsList.innerHTML = '<div style="text-align:center; padding:50px 20px; background:#fff; border-radius:8px; border:1px solid #e2e8f0;"><i class="fa-regular fa-newspaper fa-3x" style="color:#94a3b8; margin-bottom:15px;"></i><h3 style="font-size:18px; color:#1e293b;">جاري إعداد أولى تقارير قسم (' + targetCat + ')</h3><p style="color:#64748b; font-size:14px; margin-top:8px;">يقوم فريق تحرير صوت مصر 24 برصد الأخبار الآن وستُنشر هنا تلقائياً.</p></div>';
                return;
              }
              
              postsList.innerHTML = '';
              matched.forEach(function(entry) {
                var title = entry.title.$t;
                var link = '';
                (entry.link || []).forEach(function(l) { if (l.rel === 'alternate') link = l.href; });
                var content = (entry.content && entry.content.$t) || '';
                var imgMatch = content.match(/<img[^>]+src="([^">]+)"/i);
                var thumb = (entry.media$thumbnail && entry.media$thumbnail.url) || (imgMatch ? imgMatch[1] : 'https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEj48ZwLVmA8_k6Bci_0nkB76DxlE2Xj_I9RWVp8DTY05EFUnjsv5NIdFUhnf4R2K5LBSfTgywrTwNDmCPLZeY6dGLTOSVRsdRSb-6dzdTGSCHRf5kiEj0fF7RgQ2lplu-zPY0nFdh6kg70/s1600/%25D8%25AA.jpg');
                thumb = thumb.replace(/\/s72-c\//, '/w640-h360-p-k-no-nu/');
                
                var snippet = (entry.summary && entry.summary.$t) || content.replace(/<[^>]+>/g, '').replace(/قسم:\s*[^\s<]+(?:\s+[^\s<]+)?\s*/, '').slice(0, 140) + '...';
                var pubDate = new Date(entry.published.$t).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
                
                var card = document.createElement('article');
                card.className = 'post-card';
                card.innerHTML = 
                  '<a class="post-thumb-wrap" href="' + link + '">' +
                    '<img class="post-thumb" src="' + thumb + '" alt="' + title + '" />' +
                  '</a>' +
                  '<div class="post-card-body">' +
                    '<div class="post-meta">' +
                      '<span class="post-cat">' + targetCat + '</span>' +
                      '<span><i class="fa-regular fa-calendar"></i> ' + pubDate + '</span>' +
                    '</div>' +
                    '<h3 class="post-title"><a href="' + link + '">' + title + '</a></h3>' +
                    '<p class="post-snippet">' + snippet + '</p>' +
                    '<div class="post-card-footer">' +
                      '<span><i class="fa-regular fa-user"></i> أحمد منصور</span>' +
                      '<a class="read-more-link" href="' + link + '">التفاصيل <i class="fa-solid fa-arrow-left"></i></a>' +
                    '</div>' +
                  '</div>';
                postsList.appendChild(card);
              });
            })
            .catch(function(err) {
              console.error('Error routing category:', err);
            });
        }
      }
    } catch(e) {
      console.error(e);
    }
  //]]>
  </script>
